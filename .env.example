# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）で発行
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# 公開URL。楽天デベロッパーの「許可されたWebサイト」に同じURLを登録する（Refererとして送信）
SITE_URL=https://example.github.io/kaimawari/

# Threads（Meta for Developers で発行した長期アクセストークンとユーザーID）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# 任意：下書きが増えたら自分の Discord に知らせる（アフィリエイトリンクは送らない）
DISCORD_WEBHOOK_URL=
